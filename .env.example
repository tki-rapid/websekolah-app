# ───────── Copy to .env.local for development. In production these come from Secret Manager (see docs/GCP-SETUP.md). ─────────
APP_URL=http://localhost:3000
PLATFORM_DOMAIN=websekolah.id

# Two separate DB logins (see scripts/db-bootstrap.sql). Tenant-scoped code uses the first, platform/auth the second.
DATABASE_URL_TENANT=postgresql://ws_tenant_app:dev-tenant-pw@127.0.0.1:54329/websekolah
DATABASE_URL_PLATFORM=postgresql://ws_platform_app:dev-platform-pw@127.0.0.1:54329/websekolah
# Owner login used ONLY by `prisma migrate deploy` (never by the running app)
DATABASE_URL_MIGRATE=postgresql://ws_migrator:dev-migrator-pw@127.0.0.1:54329/websekolah

# 32+ random bytes, base64:   openssl rand -base64 48
APP_SECRET=
TOTP_ENC_KEY=

# Login with Google — create an OAuth client (Web) at console.cloud.google.com/apis/credentials
#   Authorized redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Number of trusted reverse-proxy hops in front of the app (Cloud Run: 1; behind a Google HTTPS LB: 2)
TRUSTED_PROXY_HOPS=1

# Seed
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=

# --- Phase 2 ---
# Outbound e-mail. Unset in dev => messages are printed to the server log instead of sent. Required in production.
SMTP_URL=
MAIL_FROM="WebSekolah <no-reply@websekolah.id>"
# Bearer token for POST /api/internal/jobs/run (Cloud Scheduler). Min 32 chars; endpoint answers 404 when unset.
JOB_RUNNER_TOKEN=
# Media storage: "local" (dev/test, ./.media-dev) or "gcs" (production, private bucket via V4 signed URLs)
MEDIA_BACKEND=local
MEDIA_BUCKET=
MEDIA_LOCAL_DIR=.media-dev
